{
  "name": "skia-wasm",
  "version": "0.0.1",
  "private": true,
  "description": "Skia Graphite on WebGPU, compiled to WebAssembly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcandillon/skia-wasm.git"
  },
  "homepage": "https://github.com/wcandillon/skia-wasm",
  "bugs": {
    "url": "https://github.com/wcandillon/skia-wasm/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wcandillon"
  },
  "packageManager": "yarn@3.6.4",
  "scripts": {
    "prepare-skia": "tsx scripts/skia.ts",
    "generate-exports": "tsx scripts/generate-exports.ts",
    "build": "tsx scripts/build.ts",
    "build-bench": "tsx scripts/build-bench.ts",
    "serve": "tsx scripts/serve.ts",
    "test": "yarn build && playwright test",
    "bench": "yarn build-bench && tsx scripts/run-bench.ts",
    "bench-report": "tsx scripts/bench-report.ts",
    "lint": "eslint . --ext .ts --max-warnings 0 --cache --fix",
    "lint:ci": "eslint . --ext .ts --max-warnings 0 --cache",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "canvaskit-wasm": "0.41.1",
    "esbuild": "~0.28.0",
    "eslint": "9.36.0",
    "eslint-config-react-native-wcandillon": "5.0.1",
    "extract-zip": "^2.0.1",
    "playwright": "1.64.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  }
}
